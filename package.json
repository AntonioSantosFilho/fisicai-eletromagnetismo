{
  "name": "fisicai-independente",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "math:render": "node scripts/render-math.cjs",
    "branding:sync": "node scripts/sync-brand-assets.cjs",
    "prepare:assets": "npm run branding:sync && npm run math:render",
    "prestart": "npm run prepare:assets",
    "preweb": "npm run prepare:assets",
    "prepreview": "npm run prepare:assets",
    "prevercel-build": "npm run prepare:assets",
    "test": "node --test tests/*.test.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preview": "expo start --web --host localhost --port 8083",
    "typecheck": "tsc --noEmit",
    "repo:check": "node scripts/prepare-repository.cjs --check",
    "repo:prepare": "node scripts/prepare-repository.cjs",
    "audit:app": "node scripts/audit-app.cjs",
    "vercel-build": "expo export",
    "tutor:start": "node server/index.cjs",
    "audit:report": "node scripts/report-audit.cjs",
    "preverify": "npm run branding:sync",
    "format": "prettier --write \"{app,components,constants,context,hooks,services,utils,server}/**/*.{ts,tsx,cjs}\"",
    "verify": "node scripts/verify-app.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@mathjax/src": "^4.1.3",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.3.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
