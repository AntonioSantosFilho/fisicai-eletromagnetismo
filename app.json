{
  "expo": {
    "name": "FisicAI Independente",
    "slug": "fisicai-independente",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#FFFFFF",
    "scheme": "fisicaiindependente",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "requireFullScreen": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.fisicai.independente"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fisicai.independente"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d7c6b50-52e6-4567-ac89-ff3199980f7f"
      }
    },
    "owner": "bereu"
  }
}
