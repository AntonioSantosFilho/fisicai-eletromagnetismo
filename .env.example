# Copie para .env.local. Credenciais ficam exclusivamente no servidor.
# Não coloque chaves em variáveis EXPO_PUBLIC_*.
TUTOR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Backend HTTPS separado em produção; no desenvolvimento web a rota é local.
EXPO_PUBLIC_TUTOR_URL=
TUTOR_ORIGINS=http://127.0.0.1:8083,http://localhost:8083
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8084
TUTOR_HOURLY_LIMIT=100
TUTOR_FEEDBACK_LOGGING=disabled
